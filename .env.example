# Identifiants pour le développement local uniquement.
# Ces valeurs sont déjà les valeurs par défaut de docker-compose.yml.
# Pour les changer : copier ce fichier en .env, puis modifier les valeurs.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
